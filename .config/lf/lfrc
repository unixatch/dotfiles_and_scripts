
set mouse true
set shell bash

# Panel sizes
set ratios 2:3:4
#set globsearch true
set incsearch true

set hidden true  # Hidden folders/files
set drawbox true
set icons true
set period 2     # Reload files on screen
set info size    # Show file sizes
set dircounts    # Show folder sizes
set promptfmt "\033[1;34m%w\033[0m/%f"
set incfilter true
set filtermethod regex

map j up
map k down
map / filter
map _ filter
map - toggle
map ss :{{
    set sortby size
    set info size
    set reverse true
}}
map sf $ffprobe -hide_banner "$f" 2>&1 | $PAGER
# Better show where the link points to
# (toggle: default ←→ link view)
map sl %{{
    [[ -z $lf_rulerfile ]] && linkRuler="~/.config/lf/linkRuler"
    lf -remote "send set rulerfile '$linkRuler'"
}}
# Shows the output of du for the selected files/folders through $PAGER
map sd ${{
    mapfile -t lines <<< "$fx"

    # Cleans up leading directories
    for (( i = 0; i < ${#lines[@]}; i++ )) ;{
        path="${lines[i]##*/}"
        lines[i]="$path"
    }
    {
        echo "-------- LIST OF FILES --------"
        du \
            --dereference-args --human-readable \
            --total "${lines[@]}" | \
        grep \
            --color="always" \
            --perl-regexp \
            '^.*\t'

    } | $PAGER --quit-at-eof

    # Old code
}}

# ratios toggle (2:3:4 ←→ 2:1)
map R ${{
    case "$lf_ratios" in
        "2:1")   ratioToSet="2:3:4" ;;
        "2:3:4") ratioToSet="2:1"   ;;
        *) ratioToSet="1:2:3" ;;
    esac
    lf -remote "send set ratios $ratioToSet"
}}
# git shortcuts
map gp %cd "$f"; git pull
map gl $cd "$f"; git l
map gc %cd "$f"; git gc --aggressive
# commands for showing/hiding a slice of a git project
map gsi %git sparse-checkout init --no-cone
map gso %git sparse-checkout disable

cmd openFiles ${{
    # Obtain file names as an array
    mapfile -t files <<< "$fx"
    for (( i = 0; i < ${#files[@]}; ++i )) ;{
        file="${files[i]}"
        [[ -f $file ]] && termux-open "$file"
    }
}}
map o openFiles
map <tab> openFiles
map Im $mpv --vo=tct --vid=1 "$f" 2>/dev/null
map L $ln -s "$f" "${f##*/}.lnk"
map Il ${{
    # Obtain file names as an array
    mapfile -t lines <<< "$fx"

    (( ${#lines[@]} > 1 )) && {
        leaf "${ pwd; }"
        exit
    }
    leaf "$f"
}}
# show multiple markdowns through pandoc
map Ip ${{
    # Obtain file names as an array
    mapfile -t lines <<< "$fx"
    linesOfFile=() # Temporary array
    content=()     # Final array

    for file in "${lines[@]}"; {
        linesOfFile[0]=" ——— ${file##*/} ——— "$'\n\n'
        mapfile -O 1 linesOfFile < "$file"
        content+=("${linesOfFile[@]}")
    }
    pandoc -f gfm -t ansi <<< "${content[@]}" | less -R
}}
# trash function shortcut for lf
map D ${{
    # Making sure everything is set up
    mkdir -p ~/.trash
    ! [[ -e ~/.trash_cleanup_time ]] && {
        DAYS_TO_WAIT=4
        days=$(( 60**2 * 24 * DAYS_TO_WAIT ))
        nextDate=$(( EPOCHSECONDS + days ))

        echo "$nextDate" > ~/.trash_cleanup_time
    }

    mapfile -t lines <<< "$fx"
    (( ${#lines[@]} <= 0 )) && exit 1

    # Ask before doing anything
    saveCursor='\e7'
    resetCursor='\e8'
    openAlternateBuffer='\e[?1049h'
    closeAlternateBuffer='\e[?1049l'
    goTo1Line='\e[H'

    printf '%b' "$saveCursor" \
                "$openAlternateBuffer" \
                "$goTo1Line"
    printf '%s\n' "${lines[@]/#*\/}"
    while read -p "Wanna trash ${#lines[@]} files/folders? [y|n] " -r confirmation ;do
        case "$confirmation" in
            y|Y|s|S) break ;;
            n|N) exit 1 ;;
            *) printf '%b' "$goTo1Line" "\e[0J" ;;
        esac
    done
    green="\e[32m"; underline="\e[4m" normal="\e[0m"
    greenTextFmt="${green}trashed$normal $underline%s$normal\n"
    for file in "${lines[@]}" ;{
        {
            mv "$file" "$HOME/.trash/" || exit

            [[ -e "$HOME/.trash/${file/#*\/}" ]] && {
                printf "$greenTextFmt" "${file/#*\/}"
            }
        } &
    }
    wait -f; read -p "Finished moving files" -rn 1
    printf '%b' "$closeAlternateBuffer" \
                "$resetCursor"
}}

map <enter> ${{ ! [[ -d "$f" ]] && $EDITOR "$f" }}
map E %{{
    baseName="${f##*/}"
    dirName="${baseName%.*}"
    echo "Processing $f to $dirName..."
    stdoutOf7z="${ 7z x -y "$f" -o"$dirName/"; }"
    exitCodeOf7z=$?

    mapfile -t stdoutOf7z <<< "$stdoutOf7z"
    for line in "${stdoutOf7z[@]}"; do
        if [[ "$line" == "Everything is Ok" ]] ;then
            echo "$line"
            exit
        fi
    done
    exit $exitCodeOf7z
}}
map <a-l> $7z l "$f" | $PAGER
map p : paste; clear
map M $mkdir "$PWD/new-dir"
map T $touch "$PWD/new-file"

map i ${{
    bat \
        --chop-long-lines \
        --pager "$PAGER" \
        --map-syntax '*.conf:ini' \
        "$f"
}}

