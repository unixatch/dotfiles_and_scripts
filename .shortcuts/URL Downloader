#!/usr/bin/env bash

# Initialisation
shopt -s expand_aliases
cd ~/storage/downloads/ || exit 1
saveCursor='\e7'
resetCursor='\e8'
openAlternateBuffer='\e[?1049h'
closeAlternateBuffer='\e[?1049l'
goTo1Line='\e[H'
# shellcheck source=../.bash_aliases
source ~/.bash_aliases

# Prepare for reading URLs
listOfUrls=()
readParams=(
    "-p" "URL: " "-e" "-n" "28"
)
readOrTimeout() {
    read -r "${readParams[@]}" URL
    [[ $? == 142 ]] && {
        printf "\n\n"
        return 142
    }
    return 0
}
resetAll() {
    [[ -n $PROMPT_DIRTRIM ]] && {
        printf '%b' \
            "$closeAlternateBuffer" \
            "$resetCursor"
    }
    exit 130
}
trap resetAll SIGINT

[[ -n $PROMPT_DIRTRIM ]] && {
    printf '%b' \
        "$saveCursor" \
        "$openAlternateBuffer" \
        "$goTo1Line"
}
while readOrTimeout ;do
    [[ $URL =~ ^https://youtu.be ]] && {
        listOfUrls+=("$URL")
        [[ -z ${readParams[5]} ]] && readParams+=("-t" "1.5")
        continue
    }
    printf "\e[F\e[2K"
    [[ -z "$URL" ]] && break
done

# Downloading part
{
    printf '%s\n' "#$EPOCHSECONDS" "yt-dlp ${listOfUrls[*]}"
} >> ~/.bash_history &

sleepHandler() {
    kill -s SIGSTOP "$1"
    printf "\n\e[90mPress anything to wake up the process...\e[0m"
    read -rn 1
    kill -s SIGCONT "$1"
    printf "\r\e[K"
}
# -s → Disables any kind of echoing from stdin
yt-dlp "${listOfUrls[@]}" &
CURRENT_SUB_PROCESS=$!
trap 'sleepHandler $CURRENT_SUB_PROCESS' SIGTSTP

# Keep waiting until everything has finished
while [[ -n ${ jobs -l; } ]]; do
    wait -f
done
trap - SIGTSTP

printf "\n\x1b[33;1;4m%s\x1b[0m" 'Download finished'
termux-media-scan ~/storage/downloads/ &>/dev/null &
wait
read -rs
[[ -n $PROMPT_DIRTRIM ]] && {
    printf '%b' \
        "$closeAlternateBuffer" \
        "$resetCursor"
} || true

