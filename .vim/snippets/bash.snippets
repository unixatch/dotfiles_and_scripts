extends "sh.snippets"

snippet fora
	for (( i = 0; i < $1; ++i )) ;{
		$0
	}
snippet forin
	for $1 in "$2" ;{
		$0
	}
snippet [[
	[[ $1 ]] && {
		$0
	}
snippet ((
	(( $1 )) && {
		$0
	}
snippet dec
	declare -p ${0}
snippet mapfile
	mapfile -t $1 <<< "$0"
snippet wr
	while read -r line ;do
		$0
	done < <($1)
snippet =~
	[[ $1 =~ $2 ]] && {
		$0
	}
snippet echoe
	echo -e "$0"
